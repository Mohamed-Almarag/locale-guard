{
  "name": "locale-guard",
  "description": "GitHub Action that checks translation files on every pull request",
  "version": "1.1.0",
  "author": "Mohamed Almearag",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/Mohamed-Almarag/locale-guard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohamed-Almarag/locale-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Mohamed-Almarag/locale-guard/issues"
  },
  "keywords": [
    "actions",
    "i18n",
    "vue-i18n",
    "next-intl",
    "translations"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "bundle": "npm run format:write && npm run package",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run package",
    "check:dist": "npm run package && git diff --exit-code --stat HEAD -- dist"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@intlify/message-compiler": "^11.4.13",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
